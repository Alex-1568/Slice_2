# ASan + UBSan on GCC/Clang. ThreadSanitizer is a separate opt-in because it
# cannot be combined with ASan and is not available on every platform/toolchain.
function(ar_enable_sanitizers target)
    if(NOT AR_ENABLE_SANITIZERS AND NOT AR_ENABLE_TSAN)
        return()
    endif()
    if(MSVC)
        if(AR_ENABLE_SANITIZERS)
            target_compile_options(${target} PRIVATE /fsanitize=address)
        endif()
        return()
    endif()
    if(AR_ENABLE_TSAN)
        target_compile_options(${target} PRIVATE -fsanitize=thread -fno-omit-frame-pointer)
        target_link_options(${target} PRIVATE -fsanitize=thread)
    else()
        target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(${target} PRIVATE -fsanitize=address,undefined)
    endif()
endfunction()
